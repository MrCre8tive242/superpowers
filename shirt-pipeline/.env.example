# Copy this file to a new file named exactly  .env  and fill in the blanks. Never share or upload .env.

# ---- Required: makes the images (and checks them if you use OpenAI for planning) ----
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_QUALITY=high

# ---- Who reads the mockup, writes the prompts and checks every layer: claude or openai ----
PLANNER_PROVIDER=claude
PLANNER_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# To compare with GPT instead:  PLANNER_PROVIDER=openai  and  PLANNER_MODEL=gpt-5.6-terra

# ---- Email alerts with the share link + preview sheet (optional but recommended) ----
NOTIFY_EMAIL_TO=Cre8tiveminds242@gmail.com
GMAIL_ADDRESS=Cre8tiveminds242@gmail.com
GMAIL_APP_PASSWORD=

# ---- Phone uploads through Google Drive (optional): the Drive-synced folder to watch ----
# INBOX_DIR=G:\My Drive\Shirt Inbox

# ---- Behaviour ----
AUTO_APPROVE=1            # 1 = hands-off (uploads to Drive by itself), 0 = wait for your approval
LONG_SLEEVE_STYLE=cut and sew
SHORT_SLEEVE_STYLE=auto
BEST_OF_HARD=2            # lettering + main graphic: make 2, keep the better one (set 1 to save money)
QA_MAX_RETRIES=2          # extra tries per layer when it fails the check

# ---- Web page. To open it from your phone, set WEB_HOST=0.0.0.0 AND a WEB_PASSWORD ----
# WEB_HOST=0.0.0.0
# WEB_PASSWORD=
# WEB_PORT=8765
